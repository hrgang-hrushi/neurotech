{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "decoder": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "eeg_morse.asgi:app",
      "functions": {
        "eeg_morse/asgi.py": {
          "excludeFiles": "{dot-reader/**,web/**,tests/**,examples/**,docs/**,scripts/**,data/**,artifacts/**,morse_bci2_copy}"
        }
      }
    },
    "dashboard": {
      "root": "dot-reader",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "decoder" } },
    { "source": "/(.*)", "destination": { "service": "dashboard" } }
  ]
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "decoder": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "eeg_morse.asgi:app"
    },
    "dashboard": {
      "root": "dot-reader",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "decoder" } },
    { "source": "/(.*)", "destination": { "service": "dashboard" } }
  ]
}
